---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    formatBookmark,
    loadBookmarks,
    nextSlug,
    normalizeUrl,
  } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const COUNTER_KEY = 'mona-bookmark-counter';
  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  let bookmarks = readBookmarks();

  function readBookmarks() {
    try {
      return loadBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function persistBookmarks() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Keep the in-memory list usable when storage is unavailable.
    }
  }

  function render() {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
          setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        }
      });

      row.append(link, separator, slug, copy);
      list.append(row);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!input) return;

    const url = normalizeUrl(input.value);
    if (!url) {
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }
    input.removeAttribute('aria-invalid');

    let counter = 0;
    try {
      const savedCounter = Number.parseInt(localStorage.getItem(COUNTER_KEY) ?? '0', 10);
      counter = Number.isFinite(savedCounter) && savedCounter >= 0 ? savedCounter : 0;
    } catch {
      counter = 0;
    }

    const slug = nextSlug(counter);
    counter += 1;
    try {
      localStorage.setItem(COUNTER_KEY, String(counter));
    } catch {
      // The bookmark can still be added if the counter cannot be stored.
    }

    bookmarks = [...bookmarks, { url, slug }];
    persistBookmarks();
    render();
    input.value = '';
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(COUNTER_KEY);
    } catch {
      // Clearing the in-memory list is sufficient if storage is unavailable.
    }
    render();
  });

  render();
</script>
